# Copy this file to .env and adjust the values you need.

# Highest video height offered (144–4320). Default: 2160 (4K).
MAX_VIDEO_HEIGHT=2160

# How many downloads may stream at the same time. Default: 4.
MAX_CONCURRENT_DOWNLOADS=4

# yt-dlp metadata cache (seconds / entries). Defaults: 600 / 64.
INFO_CACHE_TTL=600
INFO_CACHE_SIZE=64

# Optional: cookies for age-restricted, sign-in-required or private media.
# Instagram and Facebook frequently need this for anything beyond public posts.
# Local/VPS — point at a Netscape cookies file:
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# Serverless (Vercel, Render, Cloud Run) — the env var *is* the file:
# YTDLP_COOKIES_B64=<base64 of cookies.txt>   (recommended)
# YTDLP_COOKIES="<raw Netscape cookies file contents>"

# Optional: route yt-dlp through a proxy.
# YTDLP_PROXY=http://user:pass@proxy.example.com:8080

# Optional: point at a specific ffmpeg build.
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe
