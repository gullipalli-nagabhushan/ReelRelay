# Copy this file to .env and adjust the values you need.
# Every setting is optional — ReelRelay works with the defaults.

# Highest video height offered (144–4320). Default: 4320 (8K).
# Lower it to 2160 for 4K-only, or 1080 for smaller files.
MAX_VIDEO_HEIGHT=4320

# How many downloads may stream at the same time. Default: 4.
MAX_CONCURRENT_DOWNLOADS=4

# yt-dlp metadata cache (seconds / entries). Defaults: 600 / 64.
INFO_CACHE_TTL=600
INFO_CACHE_SIZE=64

# Optional: cookies for age-restricted, sign-in-required or private media.
# This is your own local machine, so point at a Netscape cookies.txt file.
# Leave this empty unless you actually need it.
# YTDLP_COOKIES_FILE=C:\Users\you\Downloads\cookies.txt

# Optional: route yt-dlp through a proxy.
# YTDLP_PROXY=http://user:pass@proxy.example.com:8080

# Optional: point at a specific ffmpeg build.
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe
