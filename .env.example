# Copy this file to .env and adjust the values you need.
# Every setting is optional — ReelRelay works with the defaults.

# Highest video height offered (144–4320). Default: 4320 (8K).
# Lower it to 2160 for 4K-only, or 1080 for smaller files.
MAX_VIDEO_HEIGHT=4320

# How many downloads may stream at the same time. Default: 4.
MAX_CONCURRENT_DOWNLOADS=4

# yt-dlp metadata cache (seconds / entries). Defaults: 600 / 64.
INFO_CACHE_TTL=600
INFO_CACHE_SIZE=64

# Look up plain lyrics on LRCLIB when the description has no lyrics block.
# Only artist, title, album and duration are sent; no account is required.
# Set to false to stay fully offline for lyrics.
REELRELAY_LYRICS_LOOKUP=true

# Prefer synchronized LRC lines in MP3/FLAC/M4A lyrics fields when the source
# provides timings. Set to false to store plain text only.
REELRELAY_LYRICS_SYNCED=true

# Optional AI lyrics and tags through Groq. This is opt-in per download: the
# audio tab gains two checkboxes, and nothing is sent to Groq unless one is
# ticked. The key stays on the server and is never sent to the browser.
# Create a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_key_here
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_TEXT_MODEL=openai/gpt-oss-20b
# REELRELAY_AI_LYRICS=true
# AI lyrics are limited to audio under 10 minutes (30-600 seconds).
# GROQ_MAX_AUDIO_SECONDS=600

# Parallel-range accelerator: CDNs throttle one connection, so high-resolution
# streams are fetched over several connections into a bounded memory window and
# handed to ffmpeg through a localhost URL. No media is written to disk.
# Set PARALLEL_DOWNLOADS=false to fall back to a single connection.
PARALLEL_DOWNLOADS=true
PARALLEL_CONNECTIONS=12
PARALLEL_SEGMENT_MB=4
PARALLEL_WINDOW_MB=32
PARALLEL_MAX_CONNECTIONS=32

# Optional: cookies for age-restricted, sign-in-required or private media.
# This is your own local machine, so point at a Netscape cookies.txt file.
# Leave this empty unless you actually need it.
# YTDLP_COOKIES_FILE=C:\Users\you\Downloads\cookies.txt

# Optional: route yt-dlp through a proxy.
# YTDLP_PROXY=http://user:pass@proxy.example.com:8080

# Optional: point at a specific ffmpeg build.
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe
