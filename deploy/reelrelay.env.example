# ReelRelay — production environment
#
# Read by Docker Compose (/etc/reelrelay/reelrelay.env) and by the bundled
# systemd unit. Keep one KEY=value per line: systemd does not accept multiline
# values, so prefer YTDLP_COOKIES_FILE on a VPS instead of pasting cookies.

# Highest video height offered (144–4320). 2160 = 4K.
MAX_VIDEO_HEIGHT=2160

# Simultaneous streams. Guide:
#   1 GB RAM (AMD micro):        1
#   2–4 GB RAM:                  2
#   8 GB+ RAM (A1.Flex 4 OCPU):  3–4
# Every stream is relayed, never stored, so this is mostly CPU + bandwidth.
MAX_CONCURRENT_DOWNLOADS=3

# yt-dlp metadata cache (seconds / entries). Preview → download reuses it.
INFO_CACHE_TTL=600
INFO_CACHE_SIZE=64

# Cookies for Instagram, Facebook and age-restricted / members-only media.
# 1. Export cookies.txt in Netscape format from a throwaway account.
# 2. Copy it to /etc/reelrelay/cookies.txt (the installer fixes ownership).
# 3. Uncomment the next line.
# YTDLP_COOKIES_FILE=/etc/reelrelay/cookies.txt

# Serverless-style alternative, if you cannot place a file on disk.
# YTDLP_COOKIES_B64=<base64 of cookies.txt>

# Optional: route yt-dlp through a proxy (residential proxies usually fix
# datacenter throttling on YouTube far better than cookies do).
# YTDLP_PROXY=http://user:password@proxy.example.com:8080

# Optional: explicit binaries (auto-detected from PATH by default).
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe
